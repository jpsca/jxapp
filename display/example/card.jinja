{#css card.css #}
{#js card.js #}
{#def title="Example Card", description="This is a Jx component rendered with TailwindCSS v4." #}
<div class="max-w-sm mx-auto mt-12">
  <div class="card rounded-xl shadow-lg overflow-hidden border border-gray-200">
    <div class="p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">{{ title }}</h2>
      <p class="text-gray-600 mb-4">{{ description }}</p>
      <button
        class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors"
        data-card-btn
      >
        Click me
      </button>
      <p id="card-message" class="mt-3 text-sm text-green-600 hidden">Button clicked!</p>
    </div>
  </div>
</div>
